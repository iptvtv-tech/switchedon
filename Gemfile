source "https://rubygems.org"

# Same pinned set GitHub Pages uses, so the preview matches the live build
gem "github-pages", "~> 232", group: :jekyll_plugins

gem "webrick", "~> 1.8"                      # needed for `jekyll serve` on newer Ruby
gem "tzinfo-data", platforms: [:windows]     # time zone data on Windows
gem "wdm", ">= 0.1.0", platforms: [:windows] # faster file watching on Windows

# Ruby 3.4 dropped these from its standard library; Jekyll 3 still needs them
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
