---
layout: null
permalink: /site.webmanifest
---
{
  "name": "Switched On",
  "short_name": "Switched On",
  "description": "Tech help for Irish homes, in plain English.",
  "start_url": "{{ '/' | relative_url }}",
  "display": "browser",
  "background_color": "#FFFFFF",
  "theme_color": "#0E7C5A",
  "icons": [
    { "src": "{{ '/assets/icons/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/icons/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ]
}
